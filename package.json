{
  "name": "memeloop-app",
  "private": true,
  "description": "MemeLoop App monorepo — desktop (Electron) + mobile (Expo)",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:repository-contracts": "node scripts/verifyPackageManagerContract.mjs && node scripts/verifyViteQueryImports.mjs",
    "check": "pnpm --dir apps/desktop run check && pnpm --filter @memeloop/mobile run typecheck",
    "lint": "pnpm --dir apps/desktop run lint --max-warnings 0 && pnpm --filter @memeloop/mobile run lint",
    "test:unit": "pnpm --dir apps/desktop run test:unit"
  },
  "devDependencies": {
    "@babel/helper-module-imports": "^7.29.7",
    "@babel/traverse": "^7.29.7"
  }
}
