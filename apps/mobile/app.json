{
  "expo": {
    "name": "MemeLoop Mobile",
    "slug": "memeloop-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../desktop/build-resources/icon.png",
    "scheme": "memeloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memeloop.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "MemeLoop discovers and connects to your trusted devices on the local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "../desktop/build-resources/icon.png"
      },
      "package": "com.memeloop.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a2e",
          "image": "../desktop/build-resources/icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
